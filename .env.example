# Kopier denne filen til .env og fyll inn. .env skal ALDRI lastes opp til GitHub (den står i .gitignore).

# Børsen du kjøper på (f.eks. Gate). Lag nøkkel med KUN "Spot trade" + "Read".
# ALDRI uttak (withdraw). Lås nøkkelen til IP-adressen til maskinen boten kjører på.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Bare for KuCoin / OKX / Bitget (passphrase):
EXCHANGE_API_PASSWORD=

# Valgfritt, men gir raskest varsel: Binance-nøkkel med KUN lesetilgang ("Enable Reading").
# Brukes bare til Binance sin offisielle annonserings-WebSocket. Ingen handel skjer på Binance.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Valgfritt: varsler på mobilen via Telegram (gratis). Se README.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
